{
  "name": "@getbrick/example-nestjs-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @getbrick/example-nestjs-postgres... build && pnpm exec tsx src/migrate.ts",
    "migrate:dry-run": "pnpm --filter @getbrick/example-nestjs-postgres... build && pnpm exec tsx src/migrate.ts --dry-run",
    "dev": "pnpm exec tsx src/dev-server.ts",
    "start": "pnpm exec tsx src/dev-server.ts",
    "load:open-platform": "pnpm exec tsx scripts/open-platform-outbox-load.ts",
    "load:open-platform:dry-run": "pnpm exec tsx scripts/open-platform-outbox-load.ts --dry-run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@getbrick/idaas-control-plane": "workspace:*",
    "@getbrick/idaas-core": "workspace:*",
    "@getbrick/idaas-nestjs": "workspace:*",
    "better-auth": "^1.7.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
